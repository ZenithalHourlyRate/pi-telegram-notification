[Unit]
Description=Pi Telegram remote control
After=network-online.target

[Service]
Type=simple
# The README's install command replaces /path/to/pi-telegram-notification with this repository's path.
ExecStart=/usr/bin/node /path/to/pi-telegram-notification/daemon.ts
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
